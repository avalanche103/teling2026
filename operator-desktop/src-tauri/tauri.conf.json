{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teling Chat",
  "version": "0.1.1",
  "identifier": "by.teling.operator-chat",
  "build": {
    "frontendDist": "https://teling.by/login?client=desktop",
    "devUrl": "https://teling.by/login?client=desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "shortDescription": "Операторский чат Teling",
    "longDescription": "Десктоп-клиент оператора чата сайта teling.by с автозапуском и системным треем."
  }
}
