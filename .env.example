# Inlined into the client at `next build`. Production falls back to G-1DC8FGVC27
# when this is unset; set it here to override. Leave unset for local `next dev`.
# NEXT_PUBLIC_GA_ID=G-1DC8FGVC27

# Yandex Metrika counter. Inlined into the client at `next build`.
# Production falls back to 114684236 when this is unset.
# NEXT_PUBLIC_YM_COUNTER_ID=114684236
# Server-only OAuth token with metrika:read. Required for /admin/stats.
# YANDEX_METRIKA_TOKEN=

# XMLRiver (SERP: Yandex + Google for admin price analysis)
XMLRIVER_USER=
XMLRIVER_KEY=
# Hourly batch cron → POST /api/admin/price-analysis/cron
PRICE_ANALYSIS_CRON_SECRET=
# Optional region overrides (IDs from XMLRiver docs — numeric for Google)
# XMLRIVER_YANDEX_LR=157
# XMLRIVER_YANDEX_DOMAIN=by
# Defaults: Google Belarus/Minsk (country=2112, loc=1001493, lr=ru)
# XMLRIVER_GOOGLE_LR=ru
# XMLRIVER_GOOGLE_COUNTRY=2112
# XMLRIVER_GOOGLE_LOC=1001493
# XMLRIVER_GOOGLE_DOMAIN=   # numeric google domain id only
