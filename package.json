{
  "name": "teling_scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,ssd -c cyan,magenta \"npm:dev:next\" \"npm:dev:ssd\"",
    "dev:next": "set NEXT_DIST_DIR=.next-dev&& next dev --webpack",
    "dev:ssd": "npm run ssd:start",
    "dev:turbo": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "ssd:install": "python -m pip install -r ssd-admin-app/requirements.txt",
    "ssd:start": "cd ssd-admin-app && python app.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "nodemailer": "^8.0.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
