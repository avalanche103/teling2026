{
  "name": "teling_scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,ssd -c cyan,magenta \"npm:dev:next\" \"npm:dev:ssd\"",
    "dev:next": "set NEXT_DIST_DIR=.next-dev&& next dev --webpack -p 6001",
    "dev:ssd": "npm run ssd:start",
    "dev:turbo": "next dev",
    "build": "next build --webpack",
    "start": "node scripts/start-next.cjs",
    "typecheck": "tsc --noEmit",
    "microinform:sync": "npx --yes tsx scripts/microinform-daily-sync.mts",
    "ssd:install": "python -m pip install -r ssd-admin-app/requirements.txt",
    "ssd:start": "cd ssd-admin-app && python app.py",
    "ssd:merge-sections": "cd ssd-admin-app && python merge_sections.py",
    "ssd:audit-catalog": "cd ssd-admin-app && python audit_catalog_drift.py",
    "ssd:download-images": "cd ssd-admin-app && python download_images.py --workers 20",
    "ssd:download-images:thumbs": "cd ssd-admin-app && python download_images.py --first-only --workers 24",
    "ssd:download-images:smoke": "cd ssd-admin-app && python download_images.py --limit 20 --workers 16",
    "ssd:sync-images": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-images.ps1"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@next/third-parties": "^16.2.4",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codepage": "^1.15.0",
    "iconv-lite": "^0.7.3",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "nodemailer": "^8.0.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.2.0",
    "sharp": "^0.35.5",
    "stream-json": "^3.9.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
